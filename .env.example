# Optional overrides for Docker Compose. Defaults work for local development.
PORT=3100
BASE_URL=http://localhost:3100
POSTGRES_USER=shortener
POSTGRES_PASSWORD=shortener_local
POSTGRES_DB=shortener
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
REDIS_TIMEOUT_MS=100

# Used with compose.dev.yaml when running Node.js directly.
# The main Compose stack supplies internal service URLs automatically.
POSTGRES_PORT=15432
REDIS_PORT=16379
DATABASE_URL=postgresql://shortener:shortener_local@localhost:15432/shortener
REDIS_URL=redis://localhost:16379
