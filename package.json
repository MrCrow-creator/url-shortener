{
  "name": "url-shortener-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Express URL shortener with PostgreSQL persistence and Redis cache-aside lookups",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "npm run build && node --test test/unit/*.test.js",
    "test:integration": "npm run build && node --test test/integration/*.test.js",
    "test:browser": "playwright test",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm test && npm run format:check",
    "benchmark": "node scripts/benchmark.js"
  },
  "dependencies": {
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "redis": "^5.10.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2"
  }
}
